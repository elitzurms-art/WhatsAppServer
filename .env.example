# מפתח API של Google Gemini — ל-AI rescue בבוט גמ"ח סקי
# השג מפתח בחינם ב: https://aistudio.google.com/apikey
# Tier חינמי: 500 בקשות/יום על gemini-2.5-flash
GEMINI_API_KEY=AIzaSy__your_key_here__

# מפתח Gemini נפרד לבוט הקניות (מפצל את ה-quota של ה-tier החינמי
# בין שני הבוטים — 500 לכל אחד = 1000 ביום סה"כ).
# אם לא מוגדר, בוט הקניות יפול חזרה ל-GEMINI_API_KEY.
GEMINI_API_KEY_SHOPPING=AIzaSy__your_shopping_key_here__

# ID של גיליון "רשימת קניות משפחתית" (נוצר ב-2026-05-17)
SHOPPING_SHEET_ID=17u5Nj9HcXrM80rlNCtkEJBdUOaQ6hGErJWY8lxPciN0

# ==== הגדרות קיימות ====
# מפתח פנימי לתקשורת עם apps-script / API server
API_KEY=a17d2A17d2

